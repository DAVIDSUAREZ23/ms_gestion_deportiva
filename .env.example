PORT=8282
CORS_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=sports_ms_project

# URL base del microservicio de seguridad (valida JWT y permisos)
MS_SECURITY=http://localhost:8181

# Clave compartida con el ms de seguridad (la misma en ambos); se envia en la cabecera X-Internal-Key
INTERNAL_SERVICE_KEY=

# Microservicio de notificaciones (envia los correos de partidos) y su clave interna, que se manda en X-Internal-Key.
# La clave debe ser la misma NOTIFICATIONS_INTERNAL_KEY de ms-notificaciones.
MS_NOTIFICATIONS=http://localhost:5000
NOTIFICATIONS_INTERNAL_KEY=
